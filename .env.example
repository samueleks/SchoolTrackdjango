# Copia a .env y ajusta. No subas .env al repositorio.

# Configuración básica
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-minimo-50-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Configuración de base de datos
DJANGO_DB_NAME=Schooltrack_db
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=tu_contraseña_aqui
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Configuración para producción (descomenta en producción)
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
# DJANGO_SECURE_COOKIES=1
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_USE_PROXY_HEADERS=1
# DJANGO_SECURE_HSTS=1

# Railway Volume: fotos de perfil y respaldos persistentes (montar volume en /app/data)
# MEDIA_ROOT=/app/data/media
# BACKUP_DIR=/app/data/backups
# SERVE_MEDIA=1

# Correo electrónico — recuperación de contraseña (producción)
# Resend (recomendado): verifica tu dominio en resend.com, luego:
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_TU_API_KEY
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=SchoolTrack <noreply@tudominio.com>
# SCHOOLTRACK_BASE_URL=https://tu-app.up.railway.app
